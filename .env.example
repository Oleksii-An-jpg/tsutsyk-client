# ─── monopay button (monobank acquiring) ────────────────────────────────
# The widget creates the invoice itself; our only job is to sign the order,
# so there is no acquiring token here — just the signing key.
#
# One-time setup, per the "Кнопка monopay" docs:
#
#   1. Generate an ECDSA P-256 key pair:
#        openssl ecparam -genkey -name prime256v1 -noout -out monopay.key
#        openssl ec -in monopay.key -pubout -out monopay.pub
#   2. Import the PUBLIC half (monopay.pub) via
#        POST https://api.monobank.ua/api/merchant/monopay/pubkey-import
#      with your merchant X-Token, passing the pubkey and a keyName.
#   3. That call returns a keyId — put it in MONOPAY_KEY_ID below, and the
#      contents of monopay.key (the PRIVATE half) in MONOPAY_PRIVATE_KEY.
#
# Never commit monopay.key. Only the public half goes to monobank.
MONOPAY_KEY_ID=

# The private key as a single line, with real newlines escaped as \n —
# the same convention this project already uses for FIREBASE_PRIVATE_KEY.
MONOPAY_PRIVATE_KEY=

# Optional. Pin a different widget build (staging, or a newer version).
# NEXT_PUBLIC_MONOPAY_WIDGET_SRC=https://pay.monobank.ua/mono-pay-button/v1/mono-pay-button.js

# Optional. Override the price per environment, in kopiykas, so staging can
# charge 1 ₴ instead of the catalogue price. Read while the landing page is
# prerendered, so set it for `next build` too — not just the running server.
# TSUTSYK_PRICE_KOPIYKAS=100
