# ─── tsutsyk-api ────────────────────────────────────────────────────────
# Absolute URL of the GraphQL API, used from the server: the catalogue is read
# through it and checkout places the order through it. It has to be absolute —
# the browser can live with a relative "/graphql", the server cannot.
API_GRAPHQL_URL=https://api.tsutsyk.live/graphql

# The same endpoint, for the browser (Apollo, and the websocket for
# subscriptions). May be relative if the API is proxied under this origin.
NEXT_PUBLIC_GRAPHQL_HTTP_URL=https://api.tsutsyk.live/graphql
# Derived from the HTTP URL when unset.
# NEXT_PUBLIC_GRAPHQL_WS_URL=wss://api.tsutsyk.live/graphql

# Public origin of this deployment. monobank returns the buyer here after
# paying, with ?order=<number> on the end. Falls back to the incoming request,
# which covers preview deployments.
NEXT_PUBLIC_SITE_URL=https://tsutsyk.live

# ─── Payments ───────────────────────────────────────────────────────────
# There is nothing to configure here. The merchant token, the invoices and the
# webhook all live in tsutsyk-api — see its .env.example. This app never talks
# to monobank directly, so the token never reaches this deployment.
