# ─── monobank acquiring (monopay) ───────────────────────────────────────
# Merchant token from https://web.monobank.ua/ (Еквайринг та послуги → API).
# Use a test token while developing — it issues payable invoices that move no
# real money.
MONOBANK_ACQUIRING_TOKEN=

# Optional. Override the invoice amount per environment, in kopiykas, so
# staging can charge 1 ₴ instead of the catalogue price.
# TSUTSYK_PRICE_KOPIYKAS=100

# Optional. Override the API host (only useful for a local mock).
# MONOBANK_API_BASE=https://api.monobank.ua

# Public origin of this deployment. Used to build the `redirectUrl` and
# `webHookUrl` monobank calls back on, so it has to be reachable from the
# internet — a tunnel (ngrok, cloudflared) during local development, since
# monobank cannot POST to localhost.
NEXT_PUBLIC_SITE_URL=https://tsutsyk.live

# Note: TSUTSYK_PRICE_KOPIYKAS and NEXT_PUBLIC_SITE_URL are read while the
# landing page is prerendered, so they must be set for `next build` too — not
# just for the running server.
