# ─── monopay button (monobank acquiring) ────────────────────────────────
# The widget creates the invoice itself; we only sign the order.
#
# One-time key setup:
#
#   openssl ecparam -name prime256v1 -genkey -out private.pem
#   openssl ec -in private.pem -pubout -out pubkey.pem
#
# Then import the PUBLIC half and keep the keyId it returns:
#
#   curl -X POST https://api.monobank.ua/api/merchant/monopay/pubkey-import \
#     -H "X-Token: $MONOBANK_ACQUIRING_TOKEN" \
#     -H "Content-Type: application/json" \
#     -d "{\"keyValue\":\"$(base64 -w0 pubkey.pem)\",\"keyName\":\"tsutsyk-live\"}"
#   # -> {"result":{"keyId":"28F91hHGtzoSFJ"}}
#
# Never commit private.pem. Only the public half goes to monobank.
MONOPAY_KEY_ID=

# The private key as a single line, with real newlines escaped as \n — the
# same convention this project already uses for FIREBASE_PRIVATE_KEY:
#   awk '{printf "%s\\n", $0}' private.pem
# Either export works: Node reads both the SEC1 ("EC PRIVATE KEY") form the
# openssl recipe above produces and the PKCS#8 ("PRIVATE KEY") form.
MONOPAY_PRIVATE_KEY=

# Merchant token from https://web.monobank.ua/ (Еквайринг та послуги → API).
# Used to import the signing key, and at runtime only to fetch the public key
# that verifies webhook signatures. Nothing here spends it.
MONOBANK_ACQUIRING_TOKEN=

# Public origin of this deployment. The signed order carries `webHookUrl` built
# from this, so it must be reachable from the internet — monobank cannot POST
# to localhost. Use a tunnel during local development.
NEXT_PUBLIC_SITE_URL=https://tsutsyk.live

# Optional. Pin a different widget build (staging, or a newer version).
# NEXT_PUBLIC_MONOPAY_WIDGET_SRC=https://pay.monobank.ua/mono-pay-button/v1/mono-pay-button.js

# Optional. Override the price per environment, in kopiykas, so staging can
# charge 1 ₴ instead of the catalogue price. Read while the landing page is
# prerendered, so set it for `next build` too — not just the running server.
# TSUTSYK_PRICE_KOPIYKAS=100
