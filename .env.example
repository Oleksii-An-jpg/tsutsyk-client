# ─── monobank internet acquiring ────────────────────────────────────────
# Merchant token from https://web.monobank.ua/ (Еквайринг та послуги → API),
# or a test token from https://api.monobank.ua/ for the sandbox.
#
# The sandbox needs no terminal and no approval — it is open to every bank
# client, and its payment page accepts any Luhn-valid card number. Check which
# one you have with `GET /api/merchant/details`: a `test_`-prefixed merchantId
# is the sandbox.
MONOBANK_ACQUIRING_TOKEN=

# Public origin of this deployment. `redirectUrl` and `webHookUrl` are built
# from it, so it has to be reachable from the internet — monobank cannot POST
# to localhost. Use a tunnel during local development.
NEXT_PUBLIC_SITE_URL=https://tsutsyk.live

# Optional. Override the API host (only useful for a local mock).
# MONOBANK_API_BASE=https://api.monobank.ua

# Optional. Override the price per environment, in kopiykas, so staging can
# charge 1 ₴ instead of the catalogue price. Read while the landing page is
# prerendered, so set it for `next build` too — not just the running server.
# TSUTSYK_PRICE_KOPIYKAS=100
